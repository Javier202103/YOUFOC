<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#E6000000"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛡️ ¡Aplicación Bloqueada!"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Estás en una sesión de Enfoque. Esta aplicación no está permitida en este momento."
        android:textColor="#CCCCCC"
        android:textSize="16sp"
        android:textAlignment="center"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnBackToFocus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Volver al Enfoque"
        android:backgroundTint="#2D69FF"
        android:textColor="#FFFFFF"
        android:padding="16dp"/>

</LinearLayout>
